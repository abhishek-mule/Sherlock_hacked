# Sherlock Hacked — environment template
# Copy to .env if you need to override defaults. Nothing here is required:
# the app reads the dataset from data/*.json and has no hosted backend.

# Local dataset produced by: python3 scripts/ingest.py
# (defaults to ./data/full-students.json)

# Optional: SOCKS5 proxy for the gated onion provider in the Go core
TOR_PROXY=

# Optional: only for building the Android APK (JDK 17)
# JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64

# Optional: skip data/auth.json and supply the operator credential via env.
# Prefer `npm run auth:setup`, which stores a salted hash in data/auth.json
# (gitignored) so nothing sensitive lives in source or in the environment.
# APP_USERNAME=
# APP_PASSWORD=
