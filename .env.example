# Sherlock Hacked — environment template
# Copy to .env and fill values. Never commit .env.

# Supabase (legacy Next.js, optional — primary DB is local SQLite)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local DB (Go core + Wails)
DATABASE_URL=sqlite://./data/sherlock.db
# For one-time import from Postgres dump, you may set POSTGRES_DSN otherwise the Go parser runs without Docker:
# POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/sherlock?sslmode=disable

# Optional: TOR proxy for onion provider (off by default)
TOR_PROXY=

# Go
GO_ENV=development
